                         ┌──────────────────────────────┐
                         │        <<abstract>>          │
                         │           Account            │
                         ├──────────────────────────────┤
                         │ - _account_number             │
                         │ - _name                       │
                         │ - _balance                    │
                         │ - _transactions               │
                         ├──────────────────────────────┤
                         │ + account_number              │
                         │ + name                        │
                         │ + balance                     │
                         │ + deposit(amount)             │
                         │ + withdraw(amount)            │
                         │ + show_transactions()         │
                         │ + show_details()              │
                         │ - _add_transaction(message)   │
                         │ + account_type()              │
                         └───────────────┬──────────────┘
                                         │
                          ┌──────────────┴──────────────┐
                          │                             │
                       inherits                      inherits
                          │                             │
                          ▼                             ▼
              ┌──────────────────────┐      ┌──────────────────────┐
              │   SavingsAccount     │      │    CurrentAccount    │
              ├──────────────────────┤      ├──────────────────────┤
              │                      │      │                      │
              ├──────────────────────┤      ├──────────────────────┤
              │ + account_type()     │      │ + account_type()     │
              │ + add_interest()     │      │                      │
              └──────────────────────┘      └──────────────────────┘


        ┌────────────────────────────────────────────────┐
        │                 Application Functions           │
